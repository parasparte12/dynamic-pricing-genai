# Required. Used by api/db.py for prediction logging (Analytics dashboard).
# Without this, the app still runs -- predictions just aren't logged.
#
# PRODUCTION / DOCKER NOTE: if this points at a Supabase project, use the Supabase
# "Connection Pooler" (Supavisor) connection string here, NOT the direct database host.
# Supabase's direct host resolves to an IPv6-only address; Docker's default container
# networking is IPv4-only, so a container cannot route to it at all (confirmed while
# testing this deployment: FastAPI crash-looped with "Network is unreachable" until
# switched to the pooler). The pooler connection string has a real IPv4 address and is
# available on your Supabase project's Database Settings page -- it is not something
# this file can provide for you.
DATABASE_URL=postgresql://username:password@host:5432/database

# Optional. Where the Streamlit app / AI assistant reach the FastAPI backend.
# Local dev default (matches api/pricing_agent.py and app/ui/api_client.py): http://127.0.0.1:8000
# In Docker Compose, this is set to the FastAPI service's network name instead, e.g.:
# API_BASE=http://fastapi:8000
API_BASE=http://127.0.0.1:8000

# Optional. Read directly by the `ollama` Python package (not by this project's own code).
# Local dev default: http://127.0.0.1:11434 (Ollama's own default when unset).
# In Docker Compose, this is set to the Ollama service's network name instead, e.g.:
# OLLAMA_HOST=http://ollama:11434
OLLAMA_HOST=http://127.0.0.1:11434
